<resources>
    <!-- Day mode window chrome; values-night overrides it so system bars follow the vehicle day/night mode. -->
    <style name="Theme.SHAREMATE" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8FA</item>
        <item name="android:navigationBarColor">#F7F8FA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#0064FF</item>
        <item name="android:windowBackground">#F7F8FA</item>
    </style>
    <!-- The brand splash stays dark in both modes. -->
    <style name="Theme.SHAREMATE.Launcher" parent="Theme.SHAREMATE">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#17181B</item>
        <item name="android:navigationBarColor">#17181B</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
